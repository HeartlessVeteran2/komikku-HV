-- Create reader_comments table for per-chapter/per-manga reader notes --
CREATE TABLE IF NOT EXISTS reader_comments(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS reader_comments_manga_id_index ON reader_comments(manga_id);
CREATE INDEX IF NOT EXISTS reader_comments_chapter_id_index ON reader_comments(chapter_id);
